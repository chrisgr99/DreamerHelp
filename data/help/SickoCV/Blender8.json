      "16": "0 to 10V · continuous · one channel only",
      "17": "0 to 10V · continuous · one channel only",
      "18": "0 to 10V · continuous · one channel only",
      "19": "0 to 10V · continuous · one channel only",
      "20": "0 to 10V · continuous · one channel only",
      "21": "0 to 10V · continuous · one channel only",
      "22": "0 to 10V · continuous · one channel only",
      "23": "0 to 10V · continuous · one channel only"
