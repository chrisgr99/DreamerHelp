{
  "plugin": "SickoCV",
  "module": "Blender8",
  "description": "Eight crossfade mixers, each blending two signals into one output, with voltage control over the blend",
  "params": [
    {"ids": [0, 1, 2, 3, 4, 5, 6, 7], "text": "Inverts the sign of the IN2 signal on that row"},
    {"ids": [8, 9, 10, 11, 12, 13, 14, 15], "text": "Sets the blend on that row, from IN1 alone at the left to IN2 alone at the right; with the row's CV patched it scales that CV, and a left-hand setting mirrors the right-hand one"},
    {"ids": [16, 17, 18, 19, 20, 21, 22, 23], "text": "Sets how that row's CV jack is read: unipolar takes 0-10V as the full sweep, bipolar adds 5V first so a signal centred on 0V covers it"}
  ],
  "inputs": [
    {"ids": [0, 1, 2, 3, 4, 5, 6, 7], "text": "One of the two signals blended on that row; the MIX knob fully anticlockwise passes it alone"},
    {"ids": [8, 9, 10, 11, 12, 13, 14, 15], "text": "One of the two signals blended on that row; the MIX knob fully clockwise passes it alone"},
    {"ids": [16, 17, 18, 19, 20, 21, 22, 23], "text": "Sets the blend on that row, scaled by the MIX knob"}
  ],
  "outputs": [
    {"ids": [0, 1, 2, 3, 4, 5, 6, 7], "text": "The blend of IN1 and IN2 on that row"}
  ],
  "expects": {
    "inputs": {
