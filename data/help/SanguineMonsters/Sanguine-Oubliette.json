      "10": "one channel only",
      "11": "one channel only",
      "12": "one channel only",
      "13": "one channel only",
      "14": "one channel only",
      "15": "one channel only"
    },
    "outputs": {
      "0": "0 to 0V · one channel only",
      "1": "0 to 0V · one channel only",
      "2": "0 to 0V · one channel only",
      "3": "0 to 0V · one channel only",
      "4": "0 to 0V · one channel only",
      "5": "0 to 0V · one channel only",
      "6": "0 to 0V · one channel only",
