{
  "plugin": "FehlerFabrik-Suite",
  "module": "Sigma",
  "description": "Adds a fixed whole number of volts to a signal, with eight outputs offset from four volts below to four volts above it; polyphonic",
  "inputs": [
    {"ids": [0], "text": "The signal every output adds its own offset to"}
  ],
  "outputs": [
    {"ids": [0], "text": "The input with 4V subtracted"},
    {"ids": [1], "text": "The input with 3V subtracted"},
    {"ids": [2], "text": "The input with 2V subtracted"},
    {"ids": [3], "text": "The input with 1V subtracted"},
    {"ids": [4], "text": "The input with 1V added"},
    {"ids": [5], "text": "The input with 2V added"},
    {"ids": [6], "text": "The input with 3V added"},
    {"ids": [7], "text": "The input with 4V added"}
  ]
}
