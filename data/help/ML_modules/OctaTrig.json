{
  "plugin": "ML_modules",
  "module": "OctaTrig",
  "description": "Eight gate-to-trigger converters, each giving a 1ms trigger on the rising edge of its gate, on the falling edge, or on both",
  "inputs": [
    {"ids": [0, 1, 2, 3, 4, 5, 6, 7], "text": "The gate that row converts, counted as high above 1V"}
  ],
  "outputs": [
    {"ids": [0, 1, 2, 3, 4, 5, 6, 7], "text": "A 1ms trigger at 10V each time that row's gate rises above 1V"},
    {"ids": [8, 9, 10, 11, 12, 13, 14, 15], "text": "A 1ms trigger at 10V each time that row's gate falls back below 1V"},
    {"ids": [16, 17, 18, 19, 20, 21, 22, 23], "text": "A 1ms trigger at 10V at both edges of that row's gate"}
  ],
  "notes": [
    "every row works polyphonically and converts each channel of its gate separately"
  ],
  "expects": {
    "inputs": {
      "0": "high above 1V · stepped · polyphonic",
      "1": "high above 1V · stepped · polyphonic",
      "2": "high above 1V · stepped · polyphonic",
      "3": "high above 1V · stepped · polyphonic",
      "4": "high above 1V · stepped · polyphonic",
      "5": "high above 1V · stepped · polyphonic",
      "6": "high above 1V · stepped · polyphonic",
      "7": "high above 1V · stepped · polyphonic"
    },
    "outputs": {
      "0": "high above 1V · stepped",
      "1": "high above 1V · stepped",
      "2": "high above 1V · stepped",
      "3": "high above 1V · stepped",
      "4": "high above 1V · stepped",
      "5": "high above 1V · stepped",
      "6": "high above 1V · stepped",
      "7": "high above 1V · stepped",
      "8": "stepped",
      "9": "stepped",
      "10": "stepped",
      "11": "stepped",
      "12": "stepped",
      "13": "stepped",
      "14": "stepped",
      "15": "stepped",
      "16": "stepped",
      "17": "stepped",
      "18": "stepped",
      "19": "stepped",
      "20": "stepped",
      "21": "stepped",
      "22": "stepped",
      "23": "stepped"
    }
  }
}
