{
  "plugin": "NYSTHI",
  "module": "GateTrigMerger",
  "description": "Four mergers, each combining four gates or triggers onto one output. Each section is an OR: its output is on while any of its four inputs is on",
  "inputs": [
    {"ids": [1, 2, 3, 4, 6, 7, 8, 9, 11, 12, 13, 14, 16, 17, 18, 19], "text": "One of the four signals merged onto that section's output"}
  ],
  "outputs": [
    {"ids": [0, 1, 2, 3], "text": "Carries a gate or a trigger while any of that section's four inputs carries one"}
  ],
  "expects": {
    "inputs": {
      "1": "stepped · one channel only",
      "2": "stepped · one channel only",
      "3": "stepped · one channel only",
      "4": "stepped · one channel only",
      "6": "stepped · one channel only",
      "7": "stepped · one channel only",
      "8": "stepped · one channel only",
      "9": "stepped · one channel only",
      "11": "stepped · one channel only",
      "12": "stepped · one channel only",
      "13": "stepped · one channel only",
      "14": "stepped · one channel only",
      "16": "stepped · one channel only",
      "17": "stepped · one channel only",
      "18": "stepped · one channel only",
      "19": "stepped · one channel only"
    },
    "outputs": {
      "0": "stepped",
      "1": "stepped",
      "2": "stepped",
      "3": "stepped"
    }
  }
}
