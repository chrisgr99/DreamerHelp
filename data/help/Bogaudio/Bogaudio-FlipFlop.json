{
  "plugin": "Bogaudio",
  "module": "Bogaudio-FlipFlop",
  "description": "Two independent flip-flops",
  "inputs": [
    {"ids": [0, 2], "text": "Flips that channel between states A and B"},
    {"ids": [1, 3], "text": "Back to A"}
  ],
  "outputs": [
    {"ids": [0, 1, 2, 3], "text": "Whichever is selected outputs 5V, the other 0V"}
  ],
  "expects": {
    "inputs": {
      "0": "high above 0.01V · stepped · polyphonic",
      "1": "high above 1V · stepped · polyphonic",
      "2": "high above 0.01V · stepped · polyphonic",
      "3": "high above 1V · stepped · polyphonic"
    },
    "outputs": {
      "0": "0 to 5V · polyphonic",
      "1": "0 to 5V · polyphonic",
      "2": "0 to 5V · polyphonic",
      "3": "0 to 5V · polyphonic"
    }
  }
}
