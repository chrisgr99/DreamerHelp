      "8": "continuous · one channel only",
      "9": "continuous · one channel only",
      "10": "continuous · one channel only",
      "11": "continuous · one channel only",
      "12": "continuous · one channel only",
      "13": "continuous · one channel only",
      "14": "continuous · one channel only",
      "15": "continuous · one channel only",
      "16": "continuous · one channel only",
      "17": "continuous · one channel only",
      "18": "continuous · one channel only",
      "19": "continuous · one channel only"
    },
    "outputs": {
      "0": "continuous",
      "1": "continuous",
      "2": "continuous",
      "3": "continuous"
    }
  }
