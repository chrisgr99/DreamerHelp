{
  "plugin": "NYSTHI",
  "module": "DeepNote",
  "facts": {
    "inputs": {
      "0": {"family": "trigger", "poly": false, "step": "stepped"},
      "1": {"family": "cv", "poly": false, "step": "continuous"},
      "2": {"family": "cv", "poly": false, "step": "continuous"},
      "3": {"family": "cv", "poly": false, "step": "continuous"},
      "4": {"family": "cv", "poly": false, "step": "continuous"},
      "5": {"family": "cv", "poly": false, "step": "continuous"}
    },
    "outputs": {
      "0": {"family": "audio"},
      "1": {"family": "audio"},
      "2": {"family": "trigger"}
    }
  },
  "comment": "THX takes the size of the voltage at inputs 1 to 5 and throws its sign away, so a negative voltage sets the same time or frequency as the matching positive one."
}
