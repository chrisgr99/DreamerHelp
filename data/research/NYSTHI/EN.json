      "3": {"family": "cv", "poly": true, "step": "continuous"},
      "4": {"family": "cv", "poly": true, "step": "continuous"},
      "5": {"family": "cv", "poly": true, "step": "continuous"}
    },
    "outputs": {
      "0": {"family": "cv", "poly": true},
