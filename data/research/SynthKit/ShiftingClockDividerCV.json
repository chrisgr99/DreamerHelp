{
  "plugin": "SynthKit",
  "module": "ShiftingClockDividerCV",
  "facts": {
    "inputs": {
      "0": {"family": "trigger"},
      "1": {"family": "cv"},
      "2": {"family": "trigger"}
    },
    "outputs": {
      "0": {"family": "trigger"},
      "1": {"family": "trigger"},
      "2": {"family": "trigger"},
      "3": {"family": "trigger"},
      "4": {"family": "trigger"},
      "5": {"family": "trigger"},
      "6": {"family": "trigger"},
      "7": {"family": "trigger"}
    }
  },
  "comment": "The CV column printed down the right of the panel gives the shift voltage that puts the /1 division on each row: 0v, 1.5, 2.5 and so on to 7.5."
}
